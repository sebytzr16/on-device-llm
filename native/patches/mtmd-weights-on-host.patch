--- a/tools/mtmd/mtmd.cpp
+++ b/tools/mtmd/mtmd.cpp
@@ -597,6 +597,7 @@ mtmd_context_params mtmd_context_params_default() {
         /* batch_max_tokens  */ 1024,
         /* progress_callback */ nullptr,
         /* progress_callback_user_data */ nullptr,
+        /* weights_on_host   */ false,
     };
     return params;
 }
@@ -722,6 +723,13 @@ struct mtmd_context {
         ggml_backend_buffer_type_t buft = device
             ? ggml_backend_dev_buffer_type(device)
             : ggml_backend_dev_buffer_type(ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU));
+        if (ctx_params.weights_on_host && device &&
+                ggml_backend_dev_type(device) != GGML_BACKEND_DEVICE_TYPE_CPU) {
+            // Prefer pinned host memory for copies to the compute device.
+            ggml_backend_buffer_type_t host = ggml_backend_dev_host_buffer_type(device);
+            buft = host ? host : ggml_backend_dev_buffer_type(
+                ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU));
+        }
         models = mtmd_model_load(mmproj_fname, model_params, buft);
 
         // soprano and pocket-tts without voice cloning have no encoder
